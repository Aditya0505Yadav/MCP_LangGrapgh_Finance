# ---------------------------------------------------------------------------
# Finance analysis assistant — environment template.
# Copy to `.env` and fill in locally. NEVER commit a real .env (see .gitignore).
# Placeholders only below.
# ---------------------------------------------------------------------------

# --- Anthropic Claude ---
# Create a local .env with your key; do not paste keys into chat or commit them.
ANTHROPIC_API_KEY=replace_locally
# A verified, available model id. Default is Claude Opus 5.5.
# Cheaper verified alternatives for the demo: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Thinking effort: low|medium|high|xhigh|max. `low` keeps the demo cheap; the
# analysts interpret pre-computed evidence, so low effort is usually enough.
CLAUDE_EFFORT=low
# Cap per LLM response. Analysts are concise; the writer gets more room.
CLAUDE_MAX_TOKENS=2000

# --- PostgreSQL (one service: checkpoints + observability, separate schemas) ---
# Driver URL format for psycopg 3 / langgraph postgres checkpointer.
# In Docker Compose the host is the `postgres` service name.
DATABASE_URL=postgresql://finance:finance@postgres:5432/finance_demo

# --- MCP server (real Streamable HTTP endpoint) ---
# The application (MCP client) connects here. Path must be /mcp.
MCP_SERVER_URL=http://mcp-server:8001/mcp
# Bind address/port for the MCP server process itself.
MCP_HOST=0.0.0.0
MCP_PORT=8001

# --- Application API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Data mode ---
# fixture = deterministic sample data through the REAL MCP transport (labeled).
# live    = real providers (stock via Stooq, no key; financials need a provider).
# The system NEVER silently falls back from live to fixture.
DATA_MODE=fixture
# Only required by the selected live financials provider (none wired by default).
FINANCIAL_DATA_API_KEY=if_required_by_selected_provider

# --- Reliability / retries ---
# Max attempts per transient external operation (initial try + retries).
MAX_EXTERNAL_ATTEMPTS=3

# --- Observability ---
# Log sanitized request/response payloads (bounded + redacted). true|false.
LOG_PAYLOADS=true
# Hard cap on any stored payload string (characters) before truncation.
PAYLOAD_MAX_CHARS=4000
# Display timezone for UTC timestamps in views (storage stays UTC).
DISPLAY_TIMEZONE=America/Chicago

# --- Fault injection (DEMO/TESTS ONLY; leave unset in normal use) ---
# Make a named workflow node raise once on the INITIAL attempt (resume succeeds).
# Example: writer  -> demonstrates checkpoint recovery of the report step.
FAIL_AT=
# Make the MCP provider raise transient provider_timeout for a symbol N times,
# then succeed -> demonstrates retry with separate attempt spans.
MCP_FAULT_TRANSIENT_SYMBOL=
MCP_FAULT_TRANSIENT_TIMES=0
